<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Results Report</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f0f0f0;
        }
        h1, h2, h3 {
            color: #333;
        }
        figure {
            border: 2px solid #ccc;
            padding: 10px;
            margin: 10px;
            background-color: #fff;
        }
        .borderless td, .borderless th {
            border: none; /* Remove borders */
        }
        .borderless {
            width: 100%;
        }
        .sidebar {
            position: fixed; /* Fix it to the left */
            left: 0;
            top: 100px; /* Adjust based on your header */
            width: 200px; /* Set a width */
            height: calc(100% - 100px); /* Full height minus header */
            overflow-y: auto; /* Enable scrolling if content overflows */
            background-color: #f9f9f9; /* Background color */
            padding: 15px; /* Padding inside the sidebar */
            border-right: 1px solid #ccc; /* Optional border */
        }

        /* Ensure the main content doesn't overlap */
        .document {
            margin-left: 220px; /* Adjust based on sidebar width */
        }
    </style>
</head>
<body>
    <h1>Results Report</h1>
    <p>Report generated on: {{ now }}</p>
    <p>Workflow Description: {{ workflow_description }}</p>
    {% for category, subcategories in results.items() %}
        <h2>{{ category.name }}</h2>
        <ul>
            {% for subcategory, files in subcategories.items() %}
                <li><h3>{{ subcategory.name }}</h3>
                    <ul>
                        {% for file in files %}
                            {{file.rendered|safe}}
                        {% endfor %}
                    </ul>
                </li>
            {% endfor %}
        </ul>
    {% endfor %}
</body>
</html>
